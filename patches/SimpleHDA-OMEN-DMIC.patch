diff --git a/Build/relink.zsh b/Build/relink.zsh
new file mode 100644
index 0000000..67a5279
--- /dev/null
+++ b/Build/relink.zsh
@@ -0,0 +1,20 @@
+#!/bin/zsh
+set -euo pipefail
+cd "${0:A:h:h}"
+res=$(xcrun clang++ -print-resource-dir)
+flags=(-target x86_64-apple-macos10.15 -mkernel -std=c++17 -nostdinc -isystem "$res/include"
+  -I Vendor/MacKernelSDK/Headers -I Generated/Headers -I Generated/kxld -I Sources -I Vendor/Lilu/Lilu
+  -D KERNEL=1 -D KERNEL_PRIVATE=1 -D __ASSERT_MACROS_DEFINE_VERSIONS_WITHOUT_UNDERSCORES=1
+  -D PRODUCT_NAME=SimpleHDA -D MODULE_VERSION=1.2.0 -D LILU_CUSTOM_KMOD_INIT=1
+  -fno-builtin -fno-stack-protector -mno-red-zone -mno-sse -mno-sse2 -mno-mmx
+  -Wno-deprecated-declarations -Wno-sign-conversion -Wno-shadow)
+for src in Generated/Payload.cpp Sources/kern_start.cpp Sources/SHDAStart.cpp Build/ManualKmod.cpp; do
+  name=${src:t:r}
+  xcrun clang++ "${flags[@]}" -c "$src" -o "Build/obj/$name.o"
+done
+xcrun clang -target x86_64-apple-macos10.15 -c Generated/Payload.S -o Build/obj/PayloadAsm.o
+bundle=Build/Release/SimpleHDA.kext
+mkdir -p "$bundle/Contents/MacOS"
+xcrun clang++ -target x86_64-apple-macos10.15 -mkernel -nostdlib -Wl,-kext,-no_fixup_chains,-undefined,dynamic_lookup Build/obj/*.o -o "$bundle/Contents/MacOS/SimpleHDA"
+sed -e 's/$(EXECUTABLE_NAME)/SimpleHDA/g' -e 's/$(PRODUCT_BUNDLE_IDENTIFIER)/cn.laobamac.SimpleHDA/g' Info.plist > "$bundle/Contents/Info.plist"
+python3 Tools/verify.py --configuration Release
